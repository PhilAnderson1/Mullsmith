[Unit]
Description=Mullsmith self-hosted chat assistant
Documentation=file:/usr/share/doc/mullsmith/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mullsmith
Group=mullsmith
ExecStart=/usr/local/bin/mullsmith -config /etc/mullsmith/config.yaml
EnvironmentFile=-/etc/mullsmith/env

Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=45

RuntimeDirectory=mullsmith
RuntimeDirectoryMode=0700

# For direct HTTPS, enable server.tls in the config, then uncomment this line
# and replace YOUR.HOSTNAME. It stages Certbot's root-owned files in private RAM.
# ExecStartPre=+/bin/sh -c 'install -m 600 -o mullsmith -g mullsmith "$(readlink -f /etc/letsencrypt/live/YOUR.HOSTNAME/privkey.pem)" /run/mullsmith/key.pem && install -m 600 -o mullsmith -g mullsmith "$(readlink -f /etc/letsencrypt/live/YOUR.HOSTNAME/fullchain.pem)" /run/mullsmith/cert.pem'

NoNewPrivileges=true
ProtectSystem=strict
ProtectKernelModules=true
RestrictSUIDSGID=false
LockPersonality=true
ReadWritePaths=/var/lib/mullsmith
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
Delegate=yes
DelegateSubgroup=payload

[Install]
WantedBy=multi-user.target
